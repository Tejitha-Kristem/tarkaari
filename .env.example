# Copy to .env.local for development. On Vercel set the same names under
# Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> API Keys (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "Publishable key" (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# "Secret key" (sb_secret_...) or legacy "service_role". SERVER ONLY: bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the app, used in share/invite links and notification links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web push (phase 6). Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" (phase 6).
# Any long random string, e.g. openssl rand -hex 32
CRON_SECRET=
