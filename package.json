{
  "name": "tarakari",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "i18n:check": "node scripts/check-messages.mjs",
    "check": "npm run i18n:check && npm run typecheck && npm run lint && npm test",
    "catalogue": "node scripts/generate-catalogue.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "db:push": "supabase db push --include-seed",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "db:test": "scripts/db-test/run.sh",
    "photo": "node scripts/add-photo.mjs",
    "stack:setup": "node scripts/dev-stack/stack.mjs setup",
    "stack": "node scripts/dev-stack/stack.mjs start",
    "db:bundle": "node scripts/bundle-sql.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
